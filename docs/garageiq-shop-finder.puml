@startuml
title GarageIQ - Performance Shop Finder Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
left to right direction

class ShopFinder {
  - location: String
  - service: String
  - useVehicle: boolean
  - shops: List<Shop>
  - busy: boolean
  - error: String
  + handleSearch()
}

class ShopSearchClient {
  - baseUrl: String
  - fetchImpl: Function
  + search(user, location, service, make): List<Shop>
}

class ShopsAPI {
  + search_shops(location, service, make): ShopSearchResponse
}

class ShopFinderService {
  - api_key: String
  + search(location, service, make): List<Shop>
}

class Shop {
  + id: String
  + name: String
  + address: String
  + rating: float
  + phone: String
  + website: URL
  + maps_url: URL
  + directions_url: URL
}

class ShopSearchResponse {
  + shops: List<Shop>
}

class GooglePlacesAPI <<External Service>> {
  + searchText(query)
}

class Settings {
  + google_places_api_key: String
}

ShopFinder --> ShopSearchClient
ShopFinder --> Shop
ShopSearchClient --> ShopsAPI
ShopsAPI --> ShopFinderService
ShopsAPI --> ShopSearchResponse
ShopFinderService --> GooglePlacesAPI
ShopFinderService --> Settings
ShopFinderService --> Shop
ShopSearchResponse o-- "0..*" Shop

@enduml
